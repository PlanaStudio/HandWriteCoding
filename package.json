{
  "name": "font-switcher",
  "displayName": "Handwrite Coding",
  "description": "Render your code in handwriting-style Google Fonts, like the viral handwritten code look",
  "version": "0.1.0",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fontSwitcher",
          "title": "Font Switcher",
          "icon": "$(symbol-text)"
        }
      ]
    },
    "views": {
      "fontSwitcher": [
        {
          "type": "webview",
          "id": "fontSwitcher.panel",
          "name": "Google Fonts"
        }
      ]
    },
    "commands": [
      {
        "command": "fontSwitcher.next",
        "title": "Font Switcher: Next Font"
      },
      {
        "command": "fontSwitcher.previous",
        "title": "Font Switcher: Previous Font"
      },
      {
        "command": "fontSwitcher.pick",
        "title": "Font Switcher: Pick Font"
      },
      {
        "command": "fontSwitcher.reset",
        "title": "Font Switcher: Reset to Default"
      },
      {
        "command": "fontSwitcher.restart",
        "title": "Font Switcher: Restart VS Code"
      },
      {
        "command": "fontSwitcher.installFile",
        "title": "Font Switcher: Install Font from File"
      },
      {
        "command": "fontSwitcher.installUrl",
        "title": "Font Switcher: Install Font from URL"
      }
    ],
    "keybindings": [
      {
        "command": "fontSwitcher.next",
        "key": "ctrl+shift+f1",
        "mac": "cmd+shift+f1"
      },
      {
        "command": "fontSwitcher.previous",
        "key": "ctrl+shift+f2",
        "mac": "cmd+shift+f2"
      },
      {
        "command": "fontSwitcher.pick",
        "key": "ctrl+shift+f3",
        "mac": "cmd+shift+f3"
      }
    ],
    "configuration": {
      "title": "Font Switcher",
      "properties": {
        "fontSwitcher.fonts": {
          "type": "array",
          "default": [
            "Caveat",
            "Kalam",
            "Shadows Into Light",
            "Indie Flower",
            "Gochi Hand",
            "Neucha",
            "Architects Daughter",
            "Permanent Marker"
          ],
          "items": {
            "type": "string"
          },
          "description": "List of fonts to cycle through"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0"
  }
}